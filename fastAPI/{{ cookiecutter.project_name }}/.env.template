# Copy to .env (done automatically at generation with fresh secrets). NEVER commit .env
# dev | staging | prod  (prod: no /docs, JSON logs, HSTS)
ENVIRONMENT=dev
LOG_LEVEL=INFO
PORT=3000
WORKERS=1

# --- security (generate: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me
BLIND_INDEX_KEY=change-me
# comma separated, no "*" in prod
ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173
ALLOWED_HOSTS=*
MAX_BODY_SIZE=10485760
MAX_UPLOAD_SIZE=5242880
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/webp,application/pdf

# --- rate limit / cache
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
CACHE_TTL=60
{%- if cookiecutter.use_redis == 'yes' %}
REDIS_URL=redis://localhost:6379/0
{%- endif %}
SCHEDULER_ENABLED=true
{% if cookiecutter.database == 'mongodb' %}
# --- mongodb
MONGODB_URL=mongodb://localhost:27017
DB_NAME={{ cookiecutter.package_slug }}
{%- elif cookiecutter.database == 'supabase' %}
# --- supabase (service-role key: server side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET_NAME=uploads
{%- endif %}
