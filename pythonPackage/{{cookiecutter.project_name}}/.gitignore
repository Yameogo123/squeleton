# --- secrets (never commit; templates stay)
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
credentials.json
service-account*.json
secrets/

# --- Claude Code: shared config (.claude/, CLAUDE.md) is committed, personal files are not
.claude/settings.local.json
CLAUDE.local.md

# --- data & model artifacts (keep the folder structure)
data/raw/*
data/interm/*
data/processed/*
!data/**/.gitkeep
models/*.pkl
models/*.joblib
*.parquet
mlruns/
.ipynb_checkpoints/
.ruff_cache/
