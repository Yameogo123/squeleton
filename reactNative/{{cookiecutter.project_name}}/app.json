{
  "expo": {
    "name": "{{ cookiecutter.project_name }}",
    "slug": "{{ cookiecutter.project_slug }}",
    "version": "{{ cookiecutter.version }}",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "{{ cookiecutter.project_slug }}",
    "userInterfaceStyle": "automatic",
    "primaryColor": "{{ cookiecutter.primary_color }}",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "{{ cookiecutter.bundle_id }}",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "{{ cookiecutter.bundle_id }}",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "allowBackup": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": { "backgroundColor": "#0B0B10" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "{{ cookiecutter.api_url }}",
      "apiPort": "{{ cookiecutter.api_port }}"
    }
  }
}
